<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="theme-color" content="#F3EEE6">
    <title><%= pageTitle %></title>
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='8' fill='%233B3835'/%3E%3Cpath d='M12 10l-6 6 6 6M20 10l6 6-6 6' fill='none' stroke='%23C9B79C' stroke-width='2.4' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E">
    <%# Тренажёр «Emmet · Тетрадь»: клиент собран из emmet/ (scripts/vendor/emmet.sh), шрифты — с сайта. %>
    <link rel="stylesheet" href="/vendor/fonts/fonts.css">
    <link rel="stylesheet" href="/vendor/emmet/emmet.css">
  </head>
  <body>
    <div class="login-screen" id="login" hidden></div>
    <div class="app" id="app" hidden>
      <header class="topbar">
        <div class="topbar-start">
          <a class="btn btn-ghost home-link" href="/" title="Вернуться на главную страницу mdtask">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M11 6l-6 6 6 6"/></svg>
            <span>Главное меню</span>
          </a>
          <div class="brand">
            <span class="brand-mark" aria-hidden="true">&lt;/&gt;</span>
            <span class="brand-name">Emmet</span>
            <span class="brand-sub">тетрадь</span>
          </div>
        </div>
        <nav class="lesson-nav" id="lesson-nav" aria-label="Задания"></nav>
        <div class="user-chip" id="user-chip"></div>
      </header>
      <main class="workspace">
        <section class="panel demo" id="demo" aria-labelledby="demo-title" hidden></section>
        <section class="panel target" id="target" aria-labelledby="target-title"></section>
        <section class="panel practice" id="practice" aria-labelledby="practice-title"></section>
      </main>
    </div>
    <div class="toast" id="toast" role="status" aria-live="polite" hidden></div>
    <noscript>Для работы тренажёра нужен JavaScript.</noscript>
    <script type="module" src="/vendor/emmet/emmet.js"></script>
  </body>
</html>
