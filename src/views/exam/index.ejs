<!-- src/views/exam/index.ejs — the exam overview: story, rules, stages with the state of every task. -->
<!DOCTYPE html>
<html lang="ru">
<head>
  <%- include('../partials/head', { pageTitle: pageTitle }) %>
</head>
<body>
  <%- include('../partials/header') %>
  <div class="app-layout">
    <%- include('../partials/sidebar') %>
    <main class="content exam-page">
      <%- include('bar') %>
      <h1><%= exam.title %>: <%= exam.subtitle.toLowerCase() %></h1>

      <section class="task-panel exam-story">
        <h2 class="task-panel-title">Ситуация</h2>
        <p>Вы — новый администратор: <strong><%= params.company %></strong>. На сервере работает <%= params.service %> (служба <code><%= params.app %></code>).
          Прежний администратор уволился, а ночью 19 ноября сервер взломали: часть данных изменена и удалена.</p>
        <p>Нужно разобраться в сервере, найти следы атаки в журнале, оценить ущерб и восстановить базу, открыть зашифрованную резервную базу,
          написать программы для обработки данных и исправить сломанные — и в конце составить отчёт.</p>
      </section>

      <section class="task-panel exam-rules">
        <h2 class="task-panel-title">Правила</h2>
        <ul>
          <li>Этапы и задания можно выполнять <strong>в любом порядке</strong> и возвращаться к ним. Невыполненное задание не засчитывается.</li>
          <li>Подсказок и теории нет. Данные у каждого студента свои.</li>
          <li>Программы с ошибками (задания 3.3–3.7): <strong>4 запуска и одна отправка</strong>, после отправки или 4-го запуска задание закрывается.</li>
          <li>Все действия на странице контрольной и в терминале записываются.</li>
          <li>Баллы объявит преподаватель после проверки.</li>
        </ul>
      </section>

      <% if (score) { %>
        <section class="task-panel exam-score">
          <h2 class="task-panel-title">Результат</h2>
          <p class="exam-score-total">Баллов: <strong><%= score.total %></strong> из <%= score.max %><% if (grade) { %> · оценка <strong><%= grade %></strong><% } else if (score.pending) { %> · отчёт ещё не оценён<% } %></p>
          <div class="sql-table-wrap">
            <table class="exam-table">
              <thead><tr><th>Задание</th><th>Баллы</th></tr></thead>
              <tbody>
                <% score.items.forEach(function (it) { %>
                  <tr><td><%= it.task.id %>. <%= it.task.title %></td><td><%= it.points === null ? '—' : it.points %> / <%= it.task.points %></td></tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </section>
      <% } %>

      <div class="exam-stage-grid">
        <% stageList.forEach(function (s) { %>
          <section class="task-panel exam-stage-card">
            <h2 class="task-panel-title"><a href="<%= base %>/stage/<%= s.n %>"><%= s.icon %> Этап <%= s.n %>. <%= s.title %></a></h2>
            <ul class="exam-task-list">
              <% s.tasks.forEach(function (t) { %>
                <% const href = (t.kind === 'algorithm' || t.kind === 'bug' || t.kind === 'sql') ? base + '/task/' + t.id : base + '/stage/' + s.n + '#q' + t.id; %>
                <li><a href="<%= href %>"><%= t.id %>. <%= t.title %></a> <span class="exam-state exam-state-<%= t.state %>"><%= t.label %></span></li>
              <% }) %>
            </ul>
          </section>
        <% }) %>
      </div>
    </main>
  </div>
  <%- include('../partials/scripts') %>
  <script src="/js/exam.js" defer></script>
</body>
</html>
