<!-- src/views/palette-course/index.ejs — предмет «Цвет и палитра»: темы по порядку, у каждой N.1 теория, N.2 практика (src/lib/palette-course) -->
<!DOCTYPE html>
<html lang="ru">
<head>
  <%- include('../partials/head', { pageTitle: subjectTitle }) %>
</head>
<body>
  <%- include('../partials/header') %>
  <div class="app-layout">
    <%- include('../partials/sidebar') %>
    <main class="content">
      <nav class="breadcrumbs"><a href="/">Главная</a> / <%= subjectTitle %></nav>
      <h1><span aria-hidden="true">🎨</span> <%= subjectTitle %></h1>
      <p class="subject-block-lead">Готовые страницы без цвета — подберите подходящую палитру. Разметка уже свёрстана, вы дописываете только цвет в CSS и выбираете его пипеткой. Тренажёр проверяет не «попадание в эталон», а теорию цвета: контраст, гармонию, акцент. Темы открываются по порядку.</p>

      <% const pct = summary.total ? Math.round((summary.solved / summary.total) * 100) : 0; %>
      <div class="subject-summary">
        <span>Решено задач: <strong><%= summary.solved %> / <%= summary.total %></strong></span>
        <span class="progress subject-summary-progress" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="<%= pct %>" aria-label="Прогресс">
          <span class="progress-fill" style="width: <%= pct %>%"></span>
        </span>
      </div>

      <ol class="html-topic-list">
        <% summary.topics.forEach(function (t) { %>
          <li class="html-topic<%= t.done ? ' is-done' : '' %><%= !t.ready || !t.theoryOpen ? ' is-locked' : '' %>">
            <span class="ib-task-num" aria-hidden="true"><%= t.done ? '✓' : t.theoryOpen ? t.number : '🔒' %></span>
            <span class="html-topic-body">
              <span class="html-topic-title">Тема <%= t.number %>. <%= t.title %></span>
              <span class="html-topic-lead"><%= t.lead %></span>
              <% if (t.adminLocked) { %><span class="topic-lock-badge">🔒 <%= t.lockReason || 'Закрыто преподавателем' %></span><% } else if (t.deadlineText) { %><span class="topic-deadline-badge">⏳ до <%= t.deadlineText %></span><% } %>
            </span>
            <span class="html-topic-steps">
              <% if (!t.ready) { %>
                <span class="topic-btn topic-btn-none">Готовится</span>
              <% } else { %>
                <% if (t.theoryOpen) { %><a class="topic-btn topic-btn-theory" href="<%= base %>/<%= t.key %>/theory"><span aria-hidden="true">📖</span> Теория</a><% } else { %><span class="topic-btn topic-btn-theory is-locked" title="Откроется после предыдущей темы"><span aria-hidden="true">🔒</span> Теория</span><% } %>
                <% if (t.practiceOpen) { %><a class="topic-btn topic-btn-practice<%= t.tasksDone ? ' is-done' : '' %>" href="<%= base %>/<%= t.key %>/practice"><span aria-hidden="true"><%= t.tasksDone ? '✓' : '🎨' %></span> Практика <span class="topic-btn-count"><%= t.solved %>/<%= t.total %></span></a><% } else { %><span class="topic-btn topic-btn-practice is-locked" title="Откроется после теории темы"><span aria-hidden="true">🔒</span> Практика <span class="topic-btn-count"><%= t.solved %>/<%= t.total %></span></span><% } %>
              <% } %>
            </span>
          </li>
        <% }) %>
      </ol>
    </main>
  </div>
  <%- include('../partials/scripts') %>
</body>
</html>
