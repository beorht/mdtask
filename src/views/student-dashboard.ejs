<!DOCTYPE html>
<html lang="ru">
<head>
  <%- include('partials/head', { pageTitle: 'Мои задания' }) %>
</head>
<body>
  <div class="app-layout">
    <%- include('partials/sidebar') %>
    <main class="content">
      <h1>Мои задания</h1>

      <h2>SQL DataBase</h2>
      <ul class="assignment-list">
        <li>
          <a class="assignment-card" href="/trainer/theory">
            <span class="assignment-card-title">Теоретический материал</span>
          </a>
        </li>
        <li>
          <a class="assignment-card" href="/trainer">
            <span class="assignment-card-title">Практический тренажёр</span>
          </a>
        </li>
      </ul>

      <% courses.forEach(function (course) { %>
        <h2><%= course.title %></h2>
        <% const courseAssignments = assignments.filter(function (a) { return a.courseId === course.id; }); %>
        <% if (courseAssignments.length === 0) { %>
          <p class="empty-state">В этом курсе пока нет заданий.</p>
        <% } else { %>
        <ul class="assignment-list">
          <% courseAssignments.forEach(function (a) { %>
            <li>
              <a class="assignment-card" href="/assignment/<%= a.id %>">
                <span class="assignment-card-title"><%= a.title %></span>
                <span class="badge badge-<%= a.status %>"></span>
                <span class="due-date<%= a.dueSoon ? ' due-soon' : '' %>">до <%= a.dueDate %></span>
                <% if (a.targetType === 'individual') { %><span class="tag">доп. задание</span><% } %>
              </a>
            </li>
          <% }) %>
        </ul>
        <% } %>
      <% }) %>
    </main>
  </div>
  <%- include('partials/scripts') %>
</body>
</html>
