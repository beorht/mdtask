<!DOCTYPE html>
<html lang="ru">
<head>
  <%- include('partials/head', { pageTitle: assignment.title }) %>
</head>
<body>
  <%- include('partials/header') %>
  <div class="app-layout">
    <%- include('partials/sidebar') %>
    <main class="content">
      <nav class="breadcrumbs"><a href="/teacher">Мои курсы</a> / <%= assignment.title %></nav>
      <% if (saved) { %><p class="empty-state">Сохранено.</p><% } %>
      <%- html %>

      <section class="submission-block task-panel">
        <h3 class="task-panel-title">Сдача</h3>
        <div class="dropzone" aria-disabled="true">Перетащите файл(ы) сюда или выберите вручную (.zip, .rar)</div>
        <p class="empty-state">Так студент сдаёт решение — предпросмотр, преподаватель здесь ничего не загружает.</p>
      </section>
    </main>
  </div>
  <%- include('partials/scripts') %>
</body>
</html>
