<!-- src/views/bash-course/task.ejs — задача темы предмета «Bash: скрипты в Linux».
     СЛЕВА: условие, примеры, правила; СПРАВА (липко): редактор, аргументы и ввод для «Запустить», вывод,
     результаты «Проверить» (public/js/bash-course.js). Проверку делает сервер тем же движком. -->
<!DOCTYPE html>
<html lang="ru">
<head>
  <%- include('../partials/head', { pageTitle: topic.number + '.' + task.number + '. ' + task.title }) %>
  <link rel="stylesheet" href="/vendor/codemirror/5.65.16/codemirror.min.css">
  <link rel="stylesheet" href="/vendor/codemirror/5.65.16/theme/material-darker.min.css">
</head>
<body>
  <%- include('../partials/header') %>
  <div class="app-layout">
    <%- include('../partials/sidebar') %>
    <main class="content pyb-page">
      <nav class="breadcrumbs"><a href="/">Главная</a> / <a href="<%= base %>"><%= subjectTitle %></a> / <a href="<%= base %>/<%= topic.key %>/theory">Тема <%= topic.number %></a> / <%= task.title %></nav>

      <header class="sql-task-head">
        <h1 class="sql-task-title"><%= topic.number %>.<%= task.number %>. <%= task.title %></h1>
        <div class="sql-task-meta">
          <span class="sql-chip sql-chip-<%= task.solved ? 'done' : 'open' %>" data-pyc-chip><%= task.solved ? '✓ Решено' : '○ Не решено' %></span>
          <span class="sql-chip">Задача <%= task.number %> / <%= topic.total %></span>
          <a class="sql-chip sql-chip-link" href="<%= base %>/<%= topic.key %>/theory">📖 Теория темы</a>
        </div>
      </header>

      <div class="pyb-workspace">
        <div class="pyb-left">
          <section class="task-panel pyb-statement">
            <h2 class="task-panel-title">📝 Условие</h2>
            <%- statementHtml %>
            <% const examples = task.tests.filter(function (t) { return t.output !== undefined; }); %>
            <% if (examples.length) { %>
              <h3>Примеры</h3>
              <div class="sql-table-wrap">
                <table class="pyb-examples">
                  <% const withArgs = examples.some(function (ex) { return ex.args && ex.args.length; }); %>
                  <% const withStdin = examples.some(function (ex) { return ex.stdin; }); %>
                  <thead><tr><% if (withArgs) { %><th>Аргументы</th><% } %><% if (withStdin) { %><th>Ввод</th><% } %><th>Вывод</th></tr></thead>
                  <tbody>
                    <% examples.forEach(function (ex) { %>
                      <tr>
                        <% if (withArgs) { %><td><pre><%= (ex.args || []).join(' ') || '—' %></pre></td><% } %>
                        <% if (withStdin) { %><td><pre><%= ex.stdin ? ex.stdin : '—' %></pre></td><% } %>
                        <td><pre><%= ex.output %></pre></td>
                      </tr>
                    <% }) %>
                  </tbody>
                </table>
              </div>
            <% } %>
            <% if (task.forbidLabels.length || task.requireLabels.length) { %>
              <h3>Правила</h3>
              <ul class="pyc-rules">
                <% if (task.requireLabels.length) { %><li>Обязательно использовать: <%= task.requireLabels.join(', ') %>.</li><% } %>
                <% if (task.forbidLabels.length) { %><li>Нельзя: <%= task.forbidLabels.join(', ') %>.</li><% } %>
              </ul>
            <% } %>
            <p class="pyb-note">Скрипт запускается как <code>bash script.sh</code> с аргументами теста; ввод подаётся на stdin (для <code>read</code>). При проверке сервер прогоняет скрипт на <%= task.tests.length %> тестах: на примерах и на других данных. Сравнивается обычный вывод (stdout).</p>
          </section>
          <nav class="pyc-task-nav" aria-label="Задачи темы">
            <% if (prev) { %><a class="topic-btn topic-btn-theory" href="<%= base %>/<%= topic.key %>/<%= prev.id %>">← <%= prev.number %>. <%= prev.title %></a><% } %>
            <% if (next) { %><a class="topic-btn topic-btn-theory" href="<%= base %>/<%= topic.key %>/<%= next.id %>"><%= next.number %>. <%= next.title %> →</a><% } %>
          </nav>
        </div>

        <section class="task-panel pyb-editor-panel" id="pycEditor"
                 data-draft-url="<%= base %>/<%= topic.key %>/<%= task.id %>/draft"
                 data-check-url="<%= base %>/<%= topic.key %>/<%= task.id %>/check"
                 data-event-url="<%= base %>/<%= topic.key %>/<%= task.id %>/event">
          <div class="sql-panel-head">
            <h2 class="task-panel-title">Ваш скрипт</h2>
            <span class="sql-hint">Ctrl+Enter — запустить</span>
          </div>
          <div class="code-file-pane">
            <textarea class="sql-console code-file-source" data-pyc-code rows="14" spellcheck="false" autocomplete="off" aria-label="Скрипт на bash"><%= task.draft %></textarea>
          </div>

          <label class="pyb-stdin-label" for="pycArgs">Аргументы для «Запустить» — через пробел</label>
          <input id="pycArgs" class="pyb-args" data-pyc-args spellcheck="false" autocomplete="off" value="<%= examples.length && examples[0].args ? examples[0].args.join(' ') : '' %>">
          <label class="pyb-stdin-label" for="pycStdin">Ввод (stdin) для «Запустить» — каждая строка отдельно</label>
          <textarea id="pycStdin" class="pyb-stdin bash-stdin" rows="2" spellcheck="false" data-pyc-stdin><%= examples.length && examples[0].stdin ? examples[0].stdin : '' %></textarea>

          <div class="code-editor-actions">
            <button type="button" class="topic-btn topic-btn-theory" data-pyc-action="run">▶ Запустить</button>
            <button type="button" class="topic-btn topic-btn-practice" data-pyc-action="check">✓ Проверить</button>
            <span class="code-editor-status" data-pyc-status aria-live="polite"></span>
          </div>

          <div class="code-output-head">Вывод</div>
          <pre class="code-output pyb-output" data-pyc-output aria-live="polite">Напишите скрипт и нажмите «Запустить» или «Проверить».</pre>

          <div class="pyb-results" data-pyc-results hidden></div>
          <p class="pyb-next" data-pyc-next <%= task.solved ? '' : 'hidden' %>>
            <% if (next) { %><a class="topic-btn topic-btn-practice" href="<%= base %>/<%= topic.key %>/<%= next.id %>">Следующая задача: <%= next.title %> →</a><% } else { %><a class="topic-btn topic-btn-practice" href="<%= base %>/<%= topic.key %>/test">К тесту темы →</a><% } %>
          </p>
        </section>
      </div>
    </main>
  </div>
  <%- include('../partials/scripts') %>
  <script src="/vendor/codemirror/5.65.16/codemirror.min.js" defer></script>
  <script src="/vendor/codemirror/5.65.16/mode/shell/shell.min.js" defer></script>
  <script src="/vendor/codemirror/5.65.16/addon/edit/matchbrackets.min.js" defer></script>
  <script src="/js/bash-engine.js" defer></script>
  <script src="/js/bash-course.js" defer></script>
</body>
</html>
