<%- include('partials/start') %>

<div class="a-page-head">
  <div>
    <h1>Web-разработка: CSS</h1>
    <p class="a-subtitle">Предмет открыт группам <strong><%= groups.join(', ') %></strong> (и TEST). Готово тем: <%= o.topics.length %> из <%= o.topics.length + o.soon.length %>, заданий: <%= o.total %>. В каждой теме — теория и практическая работа; студент пишет только CSS к готовой разметке. Совпадение с образцом проверяет браузер студента, обязательные приёмы задания — сервер.</p>
  </div>
</div>

<div class="a-page-actions" style="margin-bottom:12px"><a class="a-btn a-btn-primary" href="/admin/css?pick=1">Выбрать 4 студентов</a></div>
<% if (o.picked) { %>
<section class="a-card">
  <div class="a-card-head"><h2>На устную проверку</h2><p class="a-muted">Сначала — студенты с сигналами (вставки, код не руками, одинаковые решения…), остальные случайно.</p></div>
  <ul class="a-timeline">
    <% o.picked.forEach(function (r) { %>
      <li><a href="/admin/css/students/<%= r.student.id %>"><%= r.student.name %></a> <span class="a-muted">решено <%= r.solved %><%= r.signals.length ? ' · ' + r.signals.join(', ') : '' %></span></li>
    <% }) %>
  </ul>
</section>
<% } %>

<form class="a-filters" method="get" action="/admin/css" data-autosubmit>
  <label class="a-input-search">
    <%- icon('search') %>
    <input type="search" name="q" value="<%= filters.q %>" placeholder="Поиск по имени или ID" aria-label="Поиск студента">
  </label>
  <label>Группа
    <select name="group">
      <option value="">все группы</option>
      <% groups.forEach(function (g) { %><option value="<%= g %>"<%= filters.group === g ? ' selected' : '' %>><%= g %></option><% }) %>
    </select>
  </label>
  <button type="submit" class="a-btn a-btn-secondary a-noscript-only">Применить</button>
</form>

<section class="a-card a-card-flush">
  <% if (!o.rows.length) { %>
    <%- include('partials/empty', { emptyIcon: 'students', emptyTitle: 'Студентов нет', emptyText: 'Здесь появятся студенты, которым открыт предмет.' }) %>
  <% } else { %>
    <div class="a-table-wrap">
      <table class="a-table a-emmet-matrix">
        <thead>
          <tr>
            <th>Студент</th>
            <% o.topics.forEach(function (t) { %><th class="a-num" title="Тема <%= t.number %>. <%= t.title %>"><%= t.number %></th><% }) %>
            <th class="a-num">Решено</th><th>Сигналы</th>
          </tr>
        </thead>
        <tbody>
          <% o.rows.forEach(function (r) { %>
            <tr>
              <td><a class="a-person" href="/admin/css/students/<%= r.student.id %>"><span class="a-avatar a-avatar-sm"><%= view.initials(r.student.name) %></span><%= r.student.name %></a></td>
              <% r.topics.forEach(function (rt, ti) {
                   const total = rt.cells.length;
                   const solved = rt.cells.filter(function (c) { return c === 'solved'; }).length;
                   const st = total && solved === total ? 'solved' : solved ? 'partial' : rt.theoryRead ? 'opened' : 'none';
                   const tp = o.topics[ti]; %>
                <td class="a-num a-emmet-cell is-<%= st %>" title="Тема <%= tp.number %>. <%= tp.title %> — решено <%= solved %> из <%= total %><%= rt.theoryRead ? ', теория прочитана' : (solved ? '' : ', не открывал') %>"><%= solved %>/<%= total %></td>
              <% }) %>
              <td class="a-num a-nowrap"><%= r.solved %> / <%= o.total %></td>
              <td class="a-muted"><%= r.signals.join(', ') || '—' %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <div class="a-card-foot a-muted">В ячейке под каждой темой — <strong>решено / всего</strong> заданий темы. Цвет: зелёный — всё решено, частично — часть решена, бледный — только теория, серый — не открывал. В шапке — номер темы, наведите для названия.</div>
  <% } %>
</section>

<% if (o.soon.length) { %>
<section class="a-card">
  <div class="a-card-head"><h2>Темы готовятся</h2></div>
  <p class="a-muted"><%= o.soon.map(function (t) { return t.number + '. ' + t.title; }).join(' · ') %></p>
</section>
<% } %>

<%- include('partials/end') %>
