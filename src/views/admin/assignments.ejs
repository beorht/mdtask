<%- include('partials/start') %>

<div class="a-page-head">
  <div>
    <h1>Задания</h1>
    <p class="a-subtitle">Все задания курсов со статистикой сдачи и проверки.</p>
  </div>
  <a class="a-btn a-btn-primary" href="/admin/assignments/new"><%- icon('plus') %> Создать задание</a>
</div>

<form class="a-filters" method="get" action="/admin/assignments" data-autosubmit>
  <label class="a-input-search">
    <%- icon('search') %>
    <input type="search" name="q" value="<%= filters.q %>" placeholder="Поиск задания" aria-label="Поиск задания">
  </label>
  <select name="course" aria-label="Курс">
    <option value="">Все курсы</option>
    <% courses.forEach(function (c) { %><option value="<%= c.id %>" <%= filters.course === c.id ? 'selected' : '' %>><%= c.title %></option><% }) %>
  </select>
  <select name="type" aria-label="Тип">
    <option value="">Любой тип</option>
    <option value="group" <%= filters.type === 'group' ? 'selected' : '' %>>Групповые</option>
    <option value="individual" <%= filters.type === 'individual' ? 'selected' : '' %>>Индивидуальные</option>
  </select>
  <select name="state" aria-label="Состояние">
    <option value="">Любое состояние</option>
    <option value="review" <%= filters.state === 'review' ? 'selected' : '' %>>Есть работы на проверке</option>
    <option value="open" <%= filters.state === 'open' ? 'selected' : '' %>>Приём открыт</option>
    <option value="closed" <%= filters.state === 'closed' ? 'selected' : '' %>>Дедлайн прошёл</option>
  </select>
  <button type="submit" class="a-btn a-btn-secondary a-noscript-only">Применить</button>
  <% if (hasFilters) { %><a class="a-btn a-btn-ghost" href="/admin/assignments">Сбросить</a><% } %>
</form>

<section class="a-card a-card-flush">
  <% if (rows.length === 0) { %>
    <% if (hasFilters) { %>
      <%- include('partials/empty', { emptyIcon: 'search', emptyTitle: 'Ничего не найдено', emptyText: 'Попробуйте изменить фильтры.', emptyHref: '/admin/assignments', emptyAction: 'Сбросить фильтры' }) %>
    <% } else { %>
      <%- include('partials/empty', { emptyIcon: 'assignments', emptyTitle: 'Заданий пока нет', emptyText: 'Создайте первое задание — студенты увидят его в своём списке.', emptyHref: '/admin/assignments/new', emptyAction: 'Создать задание' }) %>
    <% } %>
  <% } else { %>
    <div class="a-table-wrap">
      <table class="a-table a-table-cards">
        <thead>
          <tr><th>Название</th><th>Курс</th><th>Тип</th><th>Назначено</th><th class="a-num">Сдано</th><th class="a-num">Проверено</th><th>Дедлайн</th><th class="a-col-action"><span class="a-sr">Действия</span></th></tr>
        </thead>
        <tbody>
          <% rows.forEach(function (r) { %>
            <tr data-href="/admin/assignments/<%= r.assignment.id %>">
              <td data-label="Название">
                <a class="a-row-title" href="/admin/assignments/<%= r.assignment.id %>"><%= r.assignment.title %></a>
                <% if (r.stats.pending > 0) { %><span class="a-tag a-tag-accent"><%= r.stats.pending %> на проверке</span><% } %>
              </td>
              <td data-label="Курс" class="a-muted a-nowrap"><%= r.course ? r.course.title : '—' %></td>
              <td data-label="Тип"><%= r.target.type %></td>
              <td data-label="Назначено" class="a-nowrap"><%= r.target.label %> <span class="a-muted">· <%= r.stats.assigned %></span></td>
              <td data-label="Сдано" class="a-num"><%= r.stats.submitted %><span class="a-muted"> / <%= r.stats.assigned %></span></td>
              <td data-label="Проверено" class="a-num"><%= r.stats.checked %><span class="a-muted"> / <%= r.stats.submitted %></span></td>
              <td data-label="Дедлайн" class="a-nowrap <%= r.pastDue ? 'a-muted' : '' %>"><%= view.formatDate(r.assignment.dueDate) %><% if (r.pastDue) { %> <span class="a-tag">закрыто</span><% } %></td>
              <td class="a-col-action">
                <div class="a-actions">
                  <a class="a-btn a-btn-secondary a-btn-sm" href="/admin/assignments/<%= r.assignment.id %>/edit" aria-label="Редактировать «<%= r.assignment.title %>»" title="Редактировать"><%- icon('edit') %></a>
                  <a class="a-btn a-btn-secondary a-btn-sm" href="/admin/assignments/<%= r.assignment.id %>">Открыть</a>
                </div>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <div class="a-card-foot a-muted">Показано: <%= rows.length %></div>
  <% } %>
</section>

<%- include('partials/end') %>
