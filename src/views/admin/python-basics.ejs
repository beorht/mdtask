<%- include('partials/start') %>

<div class="a-page-head">
  <div>
    <h1>Python: первые шаги</h1>
    <p class="a-subtitle">Раздел «Простое программирование на Python», тема «Переменные и типы данных»: <%= results.tasks.length %> заданий с автопроверкой. Код выполняется в браузере студента, сервер сверяет вывод с тестами.</p>
  </div>
</div>

<p class="a-muted">
  <% if (results.groups.length) { %>Раздел открыт группам: <strong><%= results.groups.join(', ') %></strong> (и TEST).<% } else { %>Раздел пока <strong>никому не открыт</strong> — его видит только группа TEST. Открыть группе: <code>PYBASICS_GROUPS</code> в <code>src/lib/python-basics.js</code>, затем перезапуск сервера.<% } %>
  Проверить файл по тестам задания: <code>python3 scripts/python-basics/check.py --task 1 файл.py</code>, решение студента: <code>--student ID</code>.
</p>

<form class="a-filters" method="get" action="/admin/python-basics" data-autosubmit>
  <label class="a-input-search">
    <%- icon('search') %>
    <input type="search" name="q" value="<%= filters.q %>" placeholder="Поиск по имени или ID" aria-label="Поиск студента">
  </label>
  <select name="group" aria-label="Группа">
    <option value="">Все группы</option>
    <% groups.forEach(function (g) { %><option value="<%= g %>" <%= filters.group === g ? 'selected' : '' %>><%= g %></option><% }) %>
  </select>
  <button type="submit" class="a-btn a-btn-secondary a-noscript-only">Применить</button>
  <% if (filters.q || filters.group) { %><a class="a-btn a-btn-ghost" href="/admin/python-basics">Сбросить</a><% } %>
</form>

<div class="a-stats">
  <div class="a-stat"><span class="a-stat-value"><%= results.total %></span><span class="a-stat-label">Видят раздел</span></div>
  <div class="a-stat"><span class="a-stat-value"><%= results.solvedAll %></span><span class="a-stat-label">Решили все задания</span></div>
</div>

<section class="a-card a-card-flush">
  <% if (results.rows.length === 0) { %>
    <%- include('partials/empty', { emptyIcon: 'book', emptyTitle: 'Пока никого нет', emptyText: 'Здесь появятся студенты, которым открыт раздел, и их результаты.' }) %>
  <% } else { %>
    <div class="a-table-wrap">
      <table class="a-table a-table-cards">
        <thead>
          <tr>
            <th>Студент</th><th>Группа</th>
            <% results.tasks.forEach(function (t) { %><th title="<%= t.title %>"><%= t.number %>. <%= t.title %></th><% }) %>
            <th class="a-num">Решено</th><th class="a-num">Проверок</th>
          </tr>
        </thead>
        <tbody>
          <% results.rows.forEach(function (r) { %>
            <tr>
              <td data-label="Студент"><a class="a-person" href="/admin/students/<%= r.student.id %>"><span class="a-avatar a-avatar-sm"><%= view.initials(r.student.name) %></span><%= r.student.name %></a></td>
              <td data-label="Группа" class="a-muted"><%= r.student.group || '—' %></td>
              <% r.cells.forEach(function (c) { const p = c.progress; %>
                <td data-label="<%= c.task.number %>. <%= c.task.title %>">
                  <% if (c.state === 'none') { %><span class="a-muted">—</span><% } else { %>
                    <a href="/admin/python-basics/<%= r.student.id %>/<%= c.task.id %>">
                      <% if (c.state === 'done') { %><%- include('partials/status', { key: 'done' }) %><% } else { %><%- include('partials/status', { key: 'in_progress' }) %> <span class="a-muted"><%= p.bestPassed %>/<%= p.total %></span><% } %>
                    </a>
                    <div class="a-muted"><%= p.attempts %> <%= view.plural(p.attempts, 'проверка', 'проверки', 'проверок') %></div>
                  <% } %>
                </td>
              <% }) %>
              <td data-label="Решено" class="a-num"><%= r.solved %> / <%= results.tasks.length %></td>
              <td data-label="Проверок" class="a-num"><%= r.attempts %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <div class="a-card-foot a-muted">Показано: <%= results.rows.length %></div>
  <% } %>
</section>

<%- include('partials/end') %>
