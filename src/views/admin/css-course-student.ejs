<%- include('partials/start') %>
<%
const d = detail; const r = d.row;
const STATE = { none: 'не открывал', opened: 'открыл', tried: 'пробовал', partial: 'вид совпал, правило не выполнено', solved: 'решено' };
const TYPE = { open: 'открыл', attempt: 'попытка', paste: 'вставка заблокирована', away: 'уходил со страницы' };
const titleOf = function (id) { const t = d.topics.flatMap(function (x) { return x.tasks; }).find(function (x) { return x.id === id; }); return t ? t.title : id; };
%>
<nav class="a-breadcrumbs" aria-label="Навигация"><a href="/admin/css">Web-разработка: CSS</a><span>/</span><span><%= d.student.name %></span></nav>

<div class="a-page-head">
  <div>
    <h1><%= d.student.name %></h1>
    <p class="a-subtitle">ID <code><%= d.student.id %></code> · группа <%= d.student.group || '—' %> · решено <strong><%= r.solved %></strong> · попыток <%= r.sum.attempts %><%= r.lastAt ? ' · последнее действие ' + view.formatDateTime(r.lastAt) : '' %></p>
    <% if (r.signals.length) { %><p class="a-muted">Сигналы: <strong><%= r.signals.join(', ') %></strong></p><% } %>
  </div>
  <div class="a-page-actions">
    <form method="post" action="/admin/css/students/<%= d.student.id %>/reset" data-confirm="Сбросить прогресс?|Прочитанная теория, решения и журнал студента по предмету CSS будут удалены.|Сбросить">
      <button type="submit" class="a-btn a-btn-secondary">Сбросить</button>
    </form>
  </div>
</div>

<% d.topics.forEach(function (t) { %>
<section class="a-card a-card-flush">
  <div class="a-card-head"><h2>Тема <%= t.number %>. <%= t.title %></h2><p class="a-muted">Теория: <%= t.theory ? 'прочитана ' + view.formatDateTime(t.theory.openedAt || t.theory.lastAt) : 'не открывал' %></p></div>
  <div class="a-table-wrap">
    <table class="a-table a-table-cards">
      <thead><tr><th>№</th><th>Задание</th><th>Состояние</th><th class="a-num">Попыток</th><th class="a-num">Вставок</th><th class="a-num">Уходов</th><th>Решено</th></tr></thead>
      <tbody>
        <% t.items.forEach(function (it) { const s = it.stats; %>
          <tr>
            <td data-label="№"><%= t.number %>.<%= it.task.number %></td>
            <td data-label="Задание"><%= it.task.title %>
              <% if (s && (s.solvedCode || s.lastCode)) { %>
                <details><summary class="a-muted"><%= s.solvedCode ? 'Код решения' : 'Последний код' %></summary><pre class="a-code"><%= s.solvedCode || s.lastCode %></pre></details>
              <% } %>
            </td>
            <td data-label="Состояние"><%- include('partials/status', { key: it.state === 'solved' ? 'done' : it.state === 'none' ? 'not_submitted' : 'in_progress' }) %> <span class="a-muted"><%= STATE[it.state] %></span><% if (s && s.solvedAfterAway) { %> <span class="a-muted">· сразу после ухода</span><% } %><% if (s && s.typing && Object.keys(s.typing).length) { %> <span class="a-muted">· ⚠ <%= Object.entries(s.typing).map(function (e) { return ({ chunk: 'готовый кусок', autotype: 'автонабор', untyped: 'кода больше, чем набрано', refCopy: 'копия эталона' }[e[0]] || e[0]) + (e[1] > 1 ? ' ×' + e[1] : ''); }).join(', ') %></span><% } %><% if (s && s.server) { %> <span class="a-muted">· сервер не подтвердил: <%= s.server %></span><% } %><% if (s && s.layoutDiff) { %> <span class="a-muted">· раскладка не как у эталона</span><% } %><% if (s && s.rules) { %> <span class="a-muted">· без нужного приёма: <%= s.rules %></span><% } %></td>
            <td data-label="Попыток" class="a-num"><%= s ? s.attempts : 0 %><%= s && s.attemptsToSolve ? ' (до решения ' + s.attemptsToSolve + ')' : '' %></td>
            <td data-label="Вставок" class="a-num"><%= s ? s.pastes : 0 %></td>
            <td data-label="Уходов" class="a-num"><%= s ? s.aways : 0 %><%= s && s.awayMs ? ' (' + Math.round(s.awayMs / 1000) + ' с)' : '' %></td>
            <td data-label="Решено" class="a-nowrap a-muted"><%= s && s.solvedAt ? view.formatDateTime(s.solvedAt) : '—' %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</section>
<% }) %>

<section class="a-card">
  <div class="a-card-head"><h2>Журнал</h2><p class="a-muted">Последние <%= d.events.length %> событий, новые сверху.</p></div>
  <% if (!d.events.length) { %><p class="a-muted">Студент ещё не открывал практические работы.</p><% } else { %>
    <ul class="a-timeline">
      <% d.events.forEach(function (e) { %>
        <li>
          <span class="a-muted a-nowrap"><%= view.formatDateTime(e.created_at) %></span>
          <%= TYPE[e.type] || e.type %> · <%= titleOf(e.item_id) %>
          <% if (e.type === 'attempt') { %><span class="a-muted">— <%= e.status %><%= e.client_status !== e.status ? ' (браузер: ' + e.client_status + ')' : '' %></span><% } %>
          <% if (e.type === 'paste') { %><span class="a-muted">— <%= e.kind %></span><% } %>
          <% if (e.type === 'away') { %><span class="a-muted">— <%= Math.round(e.ms / 1000) %> с</span><% } %>
        </li>
      <% }) %>
    </ul>
  <% } %>
</section>

<%- include('partials/end') %>
