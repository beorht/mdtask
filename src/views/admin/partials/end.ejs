    </div>
  </main>
</div>

<dialog class="a-dialog" data-confirm-dialog aria-labelledby="confirmTitle">
  <form method="dialog" class="a-dialog-body">
    <h2 id="confirmTitle" data-confirm-title>Подтвердите действие</h2>
    <p data-confirm-text></p>
    <div class="a-dialog-actions">
      <button type="submit" value="cancel" class="a-btn a-btn-secondary">Отмена</button>
      <button type="submit" value="ok" class="a-btn a-btn-primary" data-confirm-ok>Подтвердить</button>
    </div>
  </form>
</dialog>
</body>
</html>
