<!-- src/views/trainer/practice-index.ejs -->
<!DOCTYPE html>
<html lang="ru">
<head>
  <%- include('../partials/head', { pageTitle: 'Практический тренажёр SQL' }) %>
</head>
<body>
  <%- include('../partials/header') %>
  <div class="app-layout">
    <%- include('../partials/sidebar') %>
    <main class="content">
      <nav class="breadcrumbs"><% if (user.role === 'student') { %><a href="/">Главная</a> / <a href="/subjects/sql">Базы данных (SQL)</a><% } else { %>SQL DataBase<% } %> / Практический тренажёр</nav>
      <h1>Практический тренажёр SQL</h1>
      <p class="empty-state">
        Темы открываются по порядку — следующая тема доступна только после того, как решено последнее задание предыдущей.
      </p>
      <% sections.forEach(function (section) { %>
      <% if (section.key !== 'topics') { %>
        <h2 class="trainer-section-title"><%= section.title %></h2>
        <p class="empty-state">Отдельный раздел с заданиями на повторение. Открывается после темы «JOIN — соединение таблиц».</p>
      <% } %>
      <ul class="assignment-list">
        <% section.topics.forEach(function (topic) { %>
          <li>
            <% if (topic.unlocked) { %>
              <a class="assignment-card" href="/trainer/practice/<%= topic.key %>">
                <span class="assignment-card-title"><%= topic.label %></span>
                <span class="badge <%= topic.solvedCount === topic.total ? 'badge-done' : 'badge-pending' %>"></span>
                <span><%= topic.solvedCount %> / <%= topic.total %></span>
              </a>
            <% } else { %>
              <span class="assignment-card assignment-card-locked">
                <span class="assignment-card-title">🔒 <%= topic.label %></span>
              </span>
            <% } %>
          </li>
        <% }) %>
      </ul>
      <% }) %>
    </main>
  </div>
  <%- include('../partials/scripts') %>
</body>
</html>
