<!-- src/views/trainer/exercise.ejs
     Layout: task description on top, then a fixed two-column workspace —
     LEFT: query result (always present) + expected result + reference tabs
           (DB structure / data / attempt history);
     RIGHT: the SQL editor, sticky so it stays in place while the left column scrolls.
     On narrow screens it stacks: description → editor → result → reference. -->
<!DOCTYPE html>
<html lang="ru">
<head>
  <%- include('../partials/head', { pageTitle: exercise.title }) %>
</head>
<body>
  <%- include('../partials/header') %>
  <div class="app-layout">
    <%- include('../partials/sidebar') %>
    <main class="content task-page sql-task">
      <nav class="breadcrumbs">
        <a href="/">Главная</a> / <a href="/subjects/sql">Базы данных (SQL)</a> /
        <a href="/trainer">Практический тренажёр</a> /
        <a href="/trainer/practice/<%= exercise.topic %>"><%= topicLabel %></a> /
        <%= exercise.title %>
      </nav>

      <header class="sql-task-head">
        <h1 class="sql-task-title"><%= exercise.title %></h1>
        <div class="sql-task-meta">
          <span class="sql-chip sql-chip-<%= exercise.solved ? 'done' : 'open' %>"><%= exercise.solved ? '✓ Решено' : '○ Не решено' %></span>
          <span class="sql-chip">Оператор: <code><%= exercise.allowedStatement %></code></span>
          <a class="sql-chip sql-chip-link" href="/trainer/theory/<%= exercise.topic %>">📖 Теория темы</a>
        </div>
      </header>

      <section class="task-panel sql-task-desc">
        <h3 class="task-panel-title">Задание</h3>
        <%- exercise.descriptionHtml %>
      </section>

      <% function resultTable(columns, rows) { %>
        <div class="sql-table-wrap">
          <table class="sql-result-table">
            <thead><tr><% columns.forEach(function (c) { %><th><%= c %></th><% }) %></tr></thead>
            <tbody>
              <% rows.forEach(function (row) { %>
                <tr><% columns.forEach(function (c) { %><td><%= row[c] === null ? 'NULL' : row[c] %></td><% }) %></tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>

      <% function renderResult(result, label) { %>
        <% if (!result) return; %>
        <% if (!result.success) { %>
          <div class="sql-alert sql-alert-error" role="alert">
            <strong>✕ Ошибка<%= label ? ' — ' + label : '' %>:</strong> <%= result.error %>
          </div>
        <% } else if (result.rows) { %>
          <% if (typeof result.isCorrect !== 'undefined') { %>
            <div class="sql-alert <%= result.isCorrect ? 'sql-alert-success' : 'sql-alert-error' %>" role="status">
              <%= result.isCorrect ? '✓ Верно! Задание засчитано.' : '✕ Результат не совпадает с ожидаемым. Сравните с таблицей «Ожидаемый результат» и попробуйте ещё раз.' %>
            </div>
          <% } %>
          <% if (result.createdTables && result.createdTables.length) { %>
            <% result.createdTables.forEach(function (t) { %>
              <p class="sql-created-caption">Таблица <code><%= t.name %></code> создана — пока в ней нет строк:</p>
              <div class="sql-table-wrap">
                <table class="sql-result-table sql-created-table">
                  <thead>
                    <tr><% t.columns.forEach(function (c) { %><th><%= c.name %><span class="sql-col-meta"><%= c.type || '—' %><%= c.pk ? ' · PK' : '' %><%= c.notnull ? ' · NOT NULL' : '' %></span></th><% }) %></tr>
                  </thead>
                  <tbody>
                    <tr class="sql-empty-row"><% t.columns.forEach(function () { %><td>&nbsp;</td><% }) %></tr>
                  </tbody>
                </table>
              </div>
            <% }) %>
          <% } else if (result.rows.length) { %>
            <p class="sql-result-count">Строк в результате: <strong><%= result.rows.length %></strong></p>
            <% resultTable(result.columns, result.rows) %>
          <% } else { %>
            <p class="sql-result-empty">Запрос выполнен, строк в результате нет<% if (typeof result.changes !== 'undefined') { %> · изменено строк: <strong><%= result.changes %></strong><% } %>.</p>
          <% } %>
        <% } %>
      <% } %>

      <div class="sql-workspace" id="workspace">
        <!-- RIGHT (sticky): SQL editor -->
        <section class="task-panel sql-editor-panel" aria-labelledby="editorTitle">
          <div class="sql-panel-head">
            <h3 class="task-panel-title" id="editorTitle">SQL-редактор</h3>
            <span class="sql-hint">Один запрос <code><%= exercise.allowedStatement %></code></span>
          </div>
          <form method="post" action="/trainer/<%= exercise.id %>/run#workspace" class="sql-console-form" id="sqlForm">
            <textarea name="sql" id="sqlEditor" class="sql-console" rows="12" spellcheck="false" autocomplete="off" aria-label="SQL-запрос" placeholder="Введите SQL-запрос…"><%= submittedSql %></textarea>
            <div class="sql-console-actions">
              <button type="submit" class="btn-secondary" id="runBtn" title="Ctrl + Enter">▶ Выполнить</button>
              <button type="submit" formaction="/trainer/<%= exercise.id %>/submit#workspace" class="btn-primary" id="submitBtn" title="Ctrl + Shift + Enter">✓ Отправить на проверку</button>
            </div>
            <% const sqlError = (submitResult && !submitResult.success && submitResult.error) || (runResult && !runResult.success && runResult.error); %>
            <% if (submitResult && submitResult.success && submitResult.isCorrect) { %>
              <div class="sql-editor-notice sql-editor-notice-success" role="status">
                <p class="sql-editor-notice-text">✓ Верно! Задание засчитано.</p>
                <% if (next && next.unlocked) { %>
                  <a href="/trainer/<%= next.id %>" class="btn btn-primary sql-next-btn">Следующее задание →</a>
                <% } else if (!next) { %>
                  <p class="sql-editor-notice-text">🎉 Это было последнее задание тренажёра!</p>
                <% } %>
              </div>
            <% } else if (sqlError) { %>
              <div class="sql-editor-notice sql-editor-notice-error" role="alert">
                <p class="sql-editor-notice-text"><strong>✕ Ошибка в SQL:</strong> <%= sqlError %></p>
              </div>
            <% } else if (submitResult && submitResult.success) { %>
              <div class="sql-editor-notice sql-editor-notice-error" role="alert">
                <p class="sql-editor-notice-text"><strong>✕ Решение не засчитано:</strong> результат не совпадает с ожидаемым. Сравните его с блоком «Ожидаемый результат» слева.</p>
              </div>
            <% } else if (runResult && runResult.success) { %>
              <div class="sql-editor-notice" role="status">
                <p class="sql-editor-notice-text">▶ Запрос выполнен — смотрите панель «Результат». Чтобы задание засчиталось, нажмите «✓ Отправить на проверку».</p>
              </div>
            <% } %>
            <p class="sql-shortcuts"><kbd>Ctrl</kbd>+<kbd>Enter</kbd> — выполнить · <kbd>Ctrl</kbd>+<kbd>Shift</kbd>+<kbd>Enter</kbd> — отправить · <kbd>Tab</kbd> — отступ</p>
          </form>
        </section>

        <!-- LEFT: query result -->
        <% const resultFailed = (runResult && !runResult.success) || (submitResult && !submitResult.success); %>
        <section class="task-panel sql-result-panel<%= (runResult || submitResult) ? ' has-result' : '' %><%= resultFailed ? ' has-error' : '' %>" aria-labelledby="resultTitle" aria-live="polite">
          <div class="sql-panel-head">
            <h3 class="task-panel-title" id="resultTitle"><%= resultFailed ? '✕ Ошибка в запросе' : 'Результат' %></h3>
            <% if (runResult) { %><span class="sql-hint">предпросмотр, не засчитывается</span><% } %>
            <% if (submitResult) { %><span class="sql-hint">проверка решения</span><% } %>
          </div>
          <% if (!runResult && !submitResult) { %>
            <div class="sql-result-placeholder">
              <p><strong>Здесь появится результат запроса.</strong></p>
              <p>Напишите запрос в редакторе и нажмите «▶ Выполнить», чтобы посмотреть результат, или «✓ Отправить на проверку», чтобы засчитать решение.</p>
            </div>
          <% } %>
          <% renderResult(runResult, null) %>
          <% renderResult(submitResult, 'проверка') %>
          <% if (expected) { %>
            <details class="sql-expected" open>
              <summary><%= expected.title %> <span class="sql-hint">(<%= expected.note %>)</span></summary>
              <% if (expected.kind === 'table') { %>
                <div class="sql-table-wrap">
                  <table class="sql-result-table sql-created-table">
                    <thead><tr><% expected.columns.forEach(function (c) { %><th><%= c.name %><span class="sql-col-meta"><%= c.meta %></span></th><% }) %></tr></thead>
                    <tbody><tr class="sql-empty-row"><% expected.columns.forEach(function () { %><td>&nbsp;</td><% }) %></tr></tbody>
                  </table>
                </div>
              <% } else if (expected.kind === 'drop') { %>
                <ul class="sql-drop-list">
                  <li class="sql-drop-gone">✕ Таблицы <code><%= expected.dropped %></code> в базе быть не должно</li>
                  <% if (expected.remaining.length) { %>
                    <li>✓ Остаются: <% expected.remaining.forEach(function (t, i) { %><code><%= t %></code><%= i < expected.remaining.length - 1 ? ', ' : '' %><% }) %></li>
                  <% } else { %>
                    <li>✓ После удаления в базе не останется таблиц</li>
                  <% } %>
                </ul>
              <% } else { %>
                <% if (expected.rows.length) { %>
                  <div class="sql-table-wrap">
                    <table class="sql-result-table">
                      <thead><tr><% expected.columns.forEach(function (c) { %><th><%= c %></th><% }) %></tr></thead>
                      <tbody>
                        <% expected.rows.forEach(function (r) { %>
                          <tr class="<%= r.changed ? 'sql-row-changed' : '' %>"><% expected.columns.forEach(function (c) { %><td><%= r.values[c] === null ? 'NULL' : r.values[c] %></td><% }) %></tr>
                        <% }) %>
                      </tbody>
                    </table>
                  </div>
                <% } else { %>
                  <p class="sql-result-empty">Строк быть не должно.</p>
                <% } %>
                <% if (expected.removed && expected.removed.length) { %>
                  <p class="sql-removed-caption"><%= expected.removedLabel %>:</p>
                  <div class="sql-table-wrap">
                    <table class="sql-result-table">
                      <thead><tr><% expected.columns.forEach(function (c) { %><th><%= c %></th><% }) %></tr></thead>
                      <tbody>
                        <% expected.removed.forEach(function (r) { %>
                          <tr class="sql-row-removed"><% expected.columns.forEach(function (c) { %><td><%= r.values[c] === null ? 'NULL' : r.values[c] %></td><% }) %></tr>
                        <% }) %>
                      </tbody>
                    </table>
                  </div>
                <% } %>
                <% if (expected.showLegend) { %>
                  <p class="sql-legend"><span class="sql-legend-new"></span> новая или изменённая строка<% if (expected.removed && expected.removed.length) { %> · <span class="sql-legend-removed"></span> <%= expected.removedLabel.toLowerCase() %><% } %></p>
                <% } %>
              <% } %>
            </details>
          <% } %>
        </section>

        <!-- LEFT: reference (DB structure / data / history) -->
        <section class="task-panel sql-ref-panel" aria-label="Справка по базе данных">
          <div class="sql-ref-tabs" role="tablist">
            <button type="button" class="sql-ref-tab is-active" role="tab" aria-selected="true" data-ref="schema">Структура БД</button>
            <button type="button" class="sql-ref-tab" role="tab" aria-selected="false" data-ref="data">Данные</button>
            <button type="button" class="sql-ref-tab" role="tab" aria-selected="false" data-ref="history">История попыток (<%= attempts.length %>)</button>
          </div>

          <div class="sql-ref-pane" role="tabpanel" data-ref-panel="schema">
            <% if (schema.length) { %>
              <div class="sql-schema-grid">
                <% schema.forEach(function (table) { %>
                  <div class="sql-schema-table">
                    <p class="sql-table-name"><%= table.name %></p>
                    <div class="sql-table-wrap">
                      <table class="sql-result-table">
                        <thead><tr><th>Колонка</th><th>Тип</th><th>NOT NULL</th><th>PK</th></tr></thead>
                        <tbody>
                          <% table.columns.forEach(function (c) { %>
                            <tr><td><%= c.name %></td><td><%= c.type %></td><td><%= c.notnull ? 'да' : 'нет' %></td><td><%= c.pk ? 'да' : '' %></td></tr>
                          <% }) %>
                        </tbody>
                      </table>
                    </div>
                  </div>
                <% }) %>
              </div>
            <% } else { %>
              <p class="empty-state">В песочнице пока нет таблиц — создайте их своим запросом.</p>
            <% } %>
          </div>

          <div class="sql-ref-pane" role="tabpanel" data-ref-panel="data">
            <% if (data.length) { %>
              <% data.forEach(function (table) { %>
                <div class="sql-schema-table">
                  <p class="sql-table-name"><%= table.name %> <span class="sql-hint"><%= table.rows.length %> стр.</span></p>
                  <% if (table.rows.length) { %>
                    <% resultTable(table.columns, table.rows) %>
                  <% } else { %>
                    <p class="empty-state">Таблица пока пуста.</p>
                  <% } %>
                </div>
              <% }) %>
            <% } else { %>
              <p class="empty-state">В песочнице пока нет таблиц с данными.</p>
            <% } %>
          </div>

          <div class="sql-ref-pane" role="tabpanel" data-ref-panel="history">
            <% if (!attempts.length) { %>
              <p class="empty-state">Вы ещё не отправляли решения по этому заданию.</p>
            <% } else { %>
              <div class="sql-table-wrap">
                <table class="sql-result-table sql-history">
                  <thead><tr><th>Время</th><th>Запрос</th><th>Результат</th></tr></thead>
                  <tbody>
                    <% attempts.forEach(function (a) { %>
                      <tr>
                        <td class="sql-nowrap"><%= new Date(a.createdAt).toLocaleString('ru-RU') %></td>
                        <td><code><%= a.submittedSql %></code></td>
                        <td>
                          <% if (a.isError) { %>
                            <span class="badge badge-not_done"></span> <%= a.errorMessage %>
                          <% } else if (a.isCorrect) { %>
                            <span class="badge badge-done"></span> верно
                          <% } else { %>
                            <span class="badge badge-pending"></span> неверно
                          <% } %>
                        </td>
                      </tr>
                    <% }) %>
                  </tbody>
                </table>
              </div>
            <% } %>
          </div>
        </section>
      </div>
    </main>
  </div>
  <%- include('../partials/scripts') %>
  <script src="/js/sql-trainer.js" defer></script>
</body>
</html>
