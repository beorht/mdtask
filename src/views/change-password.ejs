<!DOCTYPE html>
<html lang="ru">
<head>
  <%- include('partials/head', { pageTitle: 'Смена пароля' }) %>
</head>
<body class="login-page">
  <main class="login-card">
    <h1>mdtask</h1>
    <% if (forced) { %>
      <p class="subtitle">Это ваш первый вход. Задайте свой пароль, чтобы продолжить.</p>
    <% } else { %>
      <p class="subtitle">Смена пароля</p>
    <% } %>
    <% if (error) { %>
      <p class="error"><%= error %></p>
    <% } %>
    <form method="post" action="/change-password">
      <label for="newPassword">Новый пароль</label>
      <input id="newPassword" name="newPassword" type="password" autofocus>
      <label for="confirmPassword">Повторите пароль</label>
      <input id="confirmPassword" name="confirmPassword" type="password">
      <button type="submit" class="btn-primary">Сохранить</button>
    </form>
    <% if (!forced) { %>
      <form method="post" action="/logout"><button type="submit" class="btn-secondary">Выйти</button></form>
    <% } %>
  </main>
</body>
</html>
