<!-- src/views/exam-locked.ejs — the group's practical work opened while the final exam runs or while the teacher keeps it closed. -->
<!DOCTYPE html>
<html lang="ru">
<head>
  <%- include('partials/head', { pageTitle: exam.during ? 'Закрыто на время контрольной' : 'Закрыто' }) %>
</head>
<body>
  <%- include('partials/header') %>
  <main class="content home">
    <section class="task-panel exam-locked">
      <% if (exam.during) { %>
        <h1>🔒 Закрыто на время контрольной</h1>
        <p>Пока идёт «<%= exam.title %>», практические задания, SQL-тренажёр и задания по информационной безопасности закрыты.</p>
      <% } else { %>
        <h1>🔒 Закрыто преподавателем</h1>
        <p>Практические задания, SQL-тренажёр и задания по информационной безопасности сейчас закрыты. Их откроет преподаватель.</p>
      <% } %>
      <p><% if (exam.during) { %><a class="btn btn-primary" href="/exam/<%= exam.id %>">Перейти к контрольной →</a> <% } %><%- include('partials/back-btn', { href: '/', label: 'На главную' }) %></p>
    </section>
  </main>
  <%- include('partials/scripts') %>
</body>
</html>
