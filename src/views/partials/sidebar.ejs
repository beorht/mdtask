<%
function countProgress(nodes) {
  let done = 0;
  let total = 0;
  nodes.forEach(function (node) {
    if (node.assignmentId) {
      total += 1;
      if (node.status === 'done') done += 1;
    }
    if (node.children && node.children.length) {
      const child = countProgress(node.children);
      done += child.done;
      total += child.total;
    }
  });
  return { done, total };
}
const courseProgress = user.role === 'student' ? countProgress(sidebarTree) : null;
const courseProgressPct = courseProgress && courseProgress.total ? Math.round((courseProgress.done / courseProgress.total) * 100) : 0;
%>
<nav class="sidebar" id="sidebar">
  <ul class="tree">
    <% sidebarTree.forEach(function renderNode(node) { %>
      <li>
        <% if (node.href) { %>
          <a href="<%= node.href %>" class="<%= typeof activePath !== 'undefined' && activePath === node.href ? 'active' : '' %> <%= node.navStatus === 'locked' ? 'nav-locked' : '' %>">
            <% if (node.navStatus) { %><span class="nav-icon nav-icon-<%= node.navStatus %>"></span><% } %>
            <%= node.title %>
          </a>
        <% } else if (node.assignmentId) { %>
          <% const assignmentHref = user.role === 'teacher' ? '/teacher/assignment/' + node.assignmentId + '/edit' : '/assignment/' + node.assignmentId; %>
          <a href="<%= assignmentHref %>" class="<%= activeAssignmentId === node.assignmentId ? 'active' : '' %>">
            <%= node.title %>
            <% if (node.status) { %><span class="badge badge-<%= node.status %>"></span><% } %>
          </a>
        <% } else { %>
          <span class="tree-section"><%= node.title %></span>
        <% } %>
        <% if (node.children && node.children.length) { %>
          <ul>
            <% node.children.forEach(renderNode) %>
          </ul>
        <% } %>
      </li>
    <% }) %>
  </ul>
  <% if (courseProgress && courseProgress.total > 0) { %>
    <div class="sidebar-progress">
      <div class="sidebar-progress-label">
        <span>Прогресс курса</span>
        <span><%= courseProgress.done %> / <%= courseProgress.total %></span>
      </div>
      <div class="progress-bar"><div class="progress-bar__fill" style="width: <%= courseProgressPct %>%"></div></div>
    </div>
  <% } %>
</nav>
