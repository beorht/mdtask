{
  "$description": "Дизайн-токены «Тетрадь» (Emmet · Тетрадь). Совпадают с docs/design/tokens.css.",
  "color": {
    "surface": {
      "page": "#F1EBE2",
      "bg": "#FBF8F3",
      "surface": "#FFFDF9",
      "border": "#E6E0D8"
    },
    "text": {
      "ink": "#3B3835",
      "inkHover": "#2B2926",
      "primary": "#3D3A36",
      "secondary": "#5A5651",
      "muted": "#776F65"
    },
    "accent": {
      "sand": "#C9B79C",
      "cream": "#EDE4D3",
      "wood": "#B88A5A",
      "woodText": "#8A5F35"
    },
    "code": {
      "tag": "#8F5B2E",
      "attr": "#5A6E4B",
      "string": "#A14B33",
      "punct": "#9A9083",
      "gutter": "#B5AB9E"
    },
    "status": {
      "success": { "fg": "#55743F", "bg": "#ECF0E3" },
      "partial": { "fg": "#9A6A2C", "bg": "#F6ECDA" },
      "error": { "fg": "#A9452F", "bg": "#F6E3DC" },
      "mismatch": { "fg": "#5A5651", "bg": "#F0EBE3" },
      "idle": { "fg": "#C9B79C", "bg": "#EDE4D3" }
    },
    "container": {
      "header": { "line": "#8BAEE0", "fill": "#DCE7F7", "ink": "#2F5FA7" },
      "nav": { "line": "#E5A56B", "fill": "#FBE3CC", "ink": "#A0571B" },
      "main": { "line": "#8CC39E", "fill": "#DEEEE2", "ink": "#2F7A4A" },
      "footer": { "line": "#A897D3", "fill": "#E7E0F3", "ink": "#6A4FA3" },
      "div": { "line": "#6AA57E", "fill": "rgba(255,255,255,0.55)", "ink": "#2F7A4A", "labelBg": "#DEEEE2" },
      "tagLabel": { "ink": "#6B7480", "bg": "#ECEAE6" },
      "idLabel": { "ink": "#2F5FA7", "bg": "#DCE7F7" },
      "classLabel": { "ink": "#A0571B", "bg": "#FBE3CC" },
      "text": "#1F2933",
      "paragraph": "#3E4A56",
      "buttonBorder": "#C9C2B8",
      "lessonSolved": "#BFDCC8"
    },
    "notebook": {
      "gridLine": "rgba(184,138,90,0.13)",
      "marginLine": "rgba(169,69,47,0.22)"
    },
    "meta": {
      "themeColor": "#F3EEE6"
    }
  },
  "font": {
    "family": {
      "display": "'Oswald', 'Arial Narrow', sans-serif",
      "ui": "'Montserrat', system-ui, sans-serif",
      "code": "'JetBrains Mono', ui-monospace, 'Cascadia Code', monospace"
    },
    "weights": { "display": [500], "ui": [400, 500, 600], "code": [400, 500] },
    "scale": {
      "displayXL": { "family": "display", "size": "34px", "lineHeight": 1.1, "weight": 500 },
      "displayL": { "family": "display", "size": "26px", "lineHeight": 1.15, "weight": 500, "letterSpacing": "0.02em" },
      "displayM": { "family": "display", "size": "24px", "lineHeight": 1.2, "weight": 500 },
      "brand": { "family": "display", "size": "22px", "lineHeight": 1, "weight": 500, "letterSpacing": "0.1em", "transform": "uppercase" },
      "panelTitle": { "family": "display", "size": "20px", "lineHeight": 1.2, "weight": 500, "letterSpacing": "0.02em" },
      "body": { "family": "ui", "size": "14px", "lineHeight": 1.5, "weight": 400 },
      "button": { "family": "ui", "size": "13px", "weight": 600 },
      "message": { "family": "ui", "size": "12.5px", "lineHeight": 1.45, "weight": 400 },
      "eyebrow": { "family": "ui", "size": "10.5px", "weight": 600, "letterSpacing": "0.16em", "transform": "uppercase" },
      "caption": { "family": "ui", "size": "10px", "weight": 600, "letterSpacing": "0.14em", "transform": "uppercase" },
      "codeEditor": { "family": "code", "size": "14px", "lineHeight": "24px" },
      "codeBlock": { "family": "code", "size": "13px", "lineHeight": 1.6 },
      "keyInput": { "family": "code", "size": "20px", "weight": 500, "letterSpacing": "0.08em" }
    }
  },
  "space": {
    "gap": "12px",
    "pad": "18px",
    "gridCell": "24px",
    "scale": ["2px", "4px", "6px", "8px", "10px", "12px", "14px", "16px", "18px", "22px", "26px", "28px"],
    "compact": { "gap": "10px", "pad": "14px", "below": "480px" }
  },
  "size": {
    "iconButton": "32px",
    "navButton": "40px",
    "button": "36px",
    "loginButton": "44px",
    "input": "48px",
    "tab": "28px",
    "matrixCell": "28px",
    "icon": "18px",
    "iconInButton": "16px"
  },
  "radius": {
    "panel": "18px",
    "inner": "12px",
    "control": "10px",
    "tab": "8px",
    "cell": "7px",
    "dot": "5px",
    "kbd": "4px",
    "pill": "999px"
  },
  "shadow": {
    "card": "0 18px 40px -24px rgba(59,56,53,0.35)",
    "toast": "0 18px 40px -20px rgba(59,56,53,0.6)",
    "dialog": "0 24px 60px -24px rgba(59,56,53,0.45)",
    "tab": "0 1px 3px rgba(59,56,53,0.15)",
    "focusRing": "0 0 0 3px rgba(201,183,156,0.25)",
    "backdrop": "rgba(59,56,53,0.38)"
  },
  "motion": {
    "easing": {
      "out": "cubic-bezier(0.22, 0.8, 0.24, 1)",
      "soft": "cubic-bezier(0.16, 1, 0.3, 1)"
    },
    "duration": {
      "panelRise": "950ms",
      "dialogRise": "420ms",
      "rise": "380ms",
      "lineIn": "380ms",
      "lineStagger": "40ms",
      "toastIn": "320ms",
      "statusColor": "320ms",
      "settle": "280ms",
      "dotWidth": "260ms",
      "border": "200ms",
      "hover": "160ms"
    },
    "stagger": { "topbar": "60ms", "target": "240ms", "practice": "420ms" }
  },
  "breakpoint": {
    "dotsCompact": "1100px",
    "singleColumn": "960px",
    "lessonStack": "760px",
    "mobile": "720px",
    "compact": "480px",
    "shortScreenHeight": "640px",
    "keyHelpContainer": "500px"
  },
  "icon": {
    "viewBox": "0 0 24 24",
    "stroke": "currentColor",
    "strokeWidth": 1.6,
    "linecap": "round",
    "linejoin": "round"
  }
}
