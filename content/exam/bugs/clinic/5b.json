{
  "id": "clinic-5b",
  "type": 5,
  "title": "Рейтинг врачей",
  "description": "Каждая строка — один приём (логин врача). Программа печатает врачей по убыванию числа приёмов (при равенстве — по алфавиту) с номером места, числом приёмов и долей в процентах (целая часть). Ввод: число приёмов N, затем N строк с логинами.",
  "tests": [
    {
      "input": [
        "6",
        "li",
        "kim",
        "li",
        "orlov",
        "li",
        "kim"
      ],
      "output": "1. li: 3 (50%)\n2. kim: 2 (33%)\n3. orlov: 1 (16%)"
    },
    {
      "input": [
        "1",
        "safarov"
      ],
      "output": "1. safarov: 1 (100%)"
    },
    {
      "input": [
        "4",
        "b",
        "a",
        "b",
        "a"
      ],
      "output": "1. a: 2 (50%)\n2. b: 2 (50%)"
    },
    {
      "input": [
        "5",
        "x",
        "y",
        "z",
        "x",
        "x"
      ],
      "output": "1. x: 3 (60%)\n2. y: 1 (20%)\n3. z: 1 (20%)"
    },
    {
      "input": [
        "3",
        "mironova",
        "hamidova",
        "yusupov"
      ],
      "output": "1. hamidova: 1 (33%)\n2. mironova: 1 (33%)\n3. yusupov: 1 (33%)"
    }
  ]
}
