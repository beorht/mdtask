          "50",
          "160"
        ],
        "output": "19.5"
      },
      {
        "input": [
          "95.5",
          "182"
        ],
        "output": "28.8"
      },
      {
        "input": [
          "120",
          "170"
        ],
        "output": "41.5"
      }
    ],
    "require": [
      "def:bmi"
    ]
  },
  {
