    "title": "Линейный поиск",
    "statement": "Даны числа через пробел и, во второй строке, искомое число. Выведите позицию первого вхождения (считая с 0) или -1. Напишите функцию linear_search(a, x).",
    "openTests": 2,
    "tests": [
      {
        "input": [
          "5 3 8 3",
          "3"
        ],
        "output": "1"
      },
      {
        "input": [
          "5 3 8 3",
          "7"
        ],
        "output": "-1"
      },
      {
        "input": [
          "1",
          "1"
        ],
        "output": "0"
      },
      {
        "input": [
          "4 4 4",
          "4"
        ],
        "output": "0"
      }
    ],
    "forbid": [
      "sorted",
      ".sort",
      "min",
      "max",
      ".index",
      "in",
      ".count",
      "reversed"
    ],
    "require": [
      "def:linear_search"
    ]
  },
