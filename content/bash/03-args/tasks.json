   },
   {
    "args": [
     "x",
     "y"
    ],
    "stdin": "",
    "output": "Аргументы: x y\n"
   }
  ]
 },
 {
  "id": "args-10",
  "title": "Нумерованный список",
  "statement": "Выведите аргументы списком с номерами: `1: <первый>`, `2: <второй>` и так далее (счётчик начните с 1).",
  "openTests": 2,
  "require": [
   "for"
  ],
  "tests": [
   {
    "args": [
     "кот",
     "пёс",
     "ёж"
    ],
