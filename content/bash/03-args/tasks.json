[
 {
  "id": "args-01",
  "title": "Имя скрипта",
  "statement": "Выведите имя скрипта (переменная `$0`).",
  "openTests": 2,
  "tests": [
   {
    "args": [],
    "stdin": "",
    "output": "script.sh\n"
   }
  ]
 },
 {
  "id": "args-02",
  "title": "Первый и второй",
  "statement": "Выведите `Первый: <$1>, второй: <$2>`.",
  "openTests": 2,
  "tests": [
   {
    "args": [
     "кот",
     "пёс"
    ],
    "stdin": "",
    "output": "Первый: кот, второй: пёс\n"
   },
   {
    "args": [
     "один",
     "два"
    ],
    "stdin": "",
    "output": "Первый: один, второй: два\n"
   }
  ]
 },
 {
  "id": "args-03",
  "title": "Сколько аргументов",
  "statement": "Выведите `Аргументов: <N>`, где N — количество переданных аргументов (`$#`).",
  "openTests": 2,
  "tests": [
   {
    "args": [
     "a",
     "b",
     "c"
    ],
    "stdin": "",
    "output": "Аргументов: 3\n"
   },
   {
    "args": [
     "x"
    ],
    "stdin": "",
    "output": "Аргументов: 1\n"
   }
  ]
 },
 {
  "id": "args-04",
  "title": "Все аргументы",
  "statement": "Переберите все аргументы (`for … in \"$@\"`) и выведите каждый на отдельной строке.",
  "openTests": 2,
  "require": [
   "for"
  ],
  "tests": [
   {
    "args": [
     "a",
     "b",
     "c"
    ],
    "stdin": "",
    "output": "a\nb\nc\n"
   },
   {
    "args": [
     "один",
     "два"
    ],
    "stdin": "",
    "output": "один\nдва\n"
   }
  ]
 },
 {
  "id": "args-05",
  "title": "Сумма чисел",
  "statement": "Сложите все переданные числа и выведите результат (`sum 3 4 5` → `12`). Используйте цикл по `\"$@\"` и `$(( ))`.",
  "openTests": 2,
  "require": [
   "for",
   "arith"
  ],
  "tests": [
   {
    "args": [
     "3",
     "4",
     "5"
    ],
    "stdin": "",
    "output": "12\n"
   },
   {
    "args": [
     "10",
     "20"
    ],
    "stdin": "",
    "output": "30\n"
   }
  ]
 },
 {
  "id": "args-06",
  "title": "Значение по умолчанию",
  "statement": "Поздоровайтесь с первым аргументом, а если его нет — со словом `гость`: `Привет, <имя>`. Используйте `${1:-гость}`.",
  "openTests": 2,
  "require": [
   "default"
  ],
  "tests": [
   {
    "args": [
     "Нина"
    ],
    "stdin": "",
    "output": "Привет, Нина\n"
   },
   {
    "args": [],
    "stdin": "",
    "output": "Привет, гость\n"
   }
  ]
 },
 {
  "id": "args-07",
  "title": "Последний аргумент",
  "statement": "Выведите последний аргумент. Подсказка: сдвиньте список на `$#-1` позиций (`shift $(($#-1))`), тогда последний станет `$1`.",
  "openTests": 2,
  "require": [
   "shift"
  ],
  "tests": [
   {
    "args": [
     "a",
     "b",
     "c"
    ],
    "stdin": "",
    "output": "c\n"
   },
   {
    "args": [
     "один",
     "два"
    ],
    "stdin": "",
    "output": "два\n"
   }
  ]
 },
 {
  "id": "args-08",
  "title": "Поменять местами",
  "statement": "Выведите первые два аргумента в обратном порядке: `<$2> <$1>`.",
  "openTests": 2,
  "tests": [
   {
    "args": [
     "лево",
     "право"
    ],
    "stdin": "",
    "output": "право лево\n"
   },
   {
    "args": [
     "1",
     "2"
    ],
    "stdin": "",
    "output": "2 1\n"
   }
  ]
 },
 {
  "id": "args-09",
  "title": "Одной строкой",
  "statement": "Выведите все аргументы одной строкой через `$*`: `Аргументы: <все>`.",
  "openTests": 2,
  "tests": [
   {
    "args": [
     "a",
     "b",
     "c"
    ],
    "stdin": "",
