    "args": [
     "x",
     "y"
    ],
    "stdin": "",
    "output": "y\n"
   }
  ]
 },
 {
  "id": "args-12",
  "title": "Через дефис",
  "statement": "Соедините все аргументы в одну строку через дефис: `a-b-c`. Подсказка: задайте `IFS=-` и выведите `\"$*\"`.",
  "openTests": 2,
  "tests": [
