   },
   {
    "args": [
     "one"
    ],
    "stdin": "",
    "output": "1: one\n"
   }
  ]
 },
 {
  "id": "args-11",
  "title": "Без первого",
  "statement": "Сдвиньте список командой `shift` и выведите оставшиеся аргументы одной строкой (`\"$@\"`).",
