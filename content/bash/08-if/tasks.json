[
 {
  "id": "if-01",
  "title": "Больше десяти",
  "statement": "Если `$1` больше 10 — выведите `больше 10`, иначе `10 или меньше`.",
  "openTests": 2,
  "require": [
   "if"
  ],
  "tests": [
   {
    "args": [
     "15"
    ],
    "stdin": "",
    "output": "больше 10\n"
   },
   {
    "args": [
     "3"
    ],
    "stdin": "",
    "output": "10 или меньше\n"
   }
  ]
 },
 {
  "id": "if-02",
  "title": "Знак числа",
  "statement": "Определите знак числа `$1`: `положительное`, `отрицательное` или `ноль` (используйте `elif`).",
  "openTests": 2,
  "require": [
   "elif"
  ],
  "tests": [
   {
    "args": [
     "5"
    ],
    "stdin": "",
    "output": "положительное\n"
   },
   {
    "args": [
     "-3"
    ],
    "stdin": "",
    "output": "отрицательное\n"
   },
   {
    "args": [
     "0"
    ],
    "stdin": "",
    "output": "ноль\n"
   }
  ]
 },
 {
  "id": "if-03",
  "title": "Сравнить два",
  "statement": "Сравните `$1` и `$2`: выведите `$1 больше $2`, `$1 меньше $2` или `равны`.",
  "openTests": 2,
  "require": [
   "elif"
  ],
  "tests": [
   {
    "args": [
     "5",
     "3"
    ],
    "stdin": "",
    "output": "5 больше 3\n"
   },
   {
    "args": [
     "2",
     "8"
    ],
    "stdin": "",
    "output": "2 меньше 8\n"
   },
   {
    "args": [
     "4",
     "4"
    ],
    "stdin": "",
    "output": "равны\n"
   }
  ]
 },
 {
  "id": "if-04",
  "title": "Строк в файле",
  "statement": "Если файл из `$1` существует — выведите `Строк: <число>` (через `wc -l < \"$1\"`), иначе `нет файла`.",
